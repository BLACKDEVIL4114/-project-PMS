<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Team Intelligence Analytics — PMS</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: #1a1a2e;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── Top Nav ── */
    .topbar {
      background: #000103;
      border-bottom: 1px solid rgba(86,203,249,.15);
      padding: 0 28px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }
    .topbar-left { display: flex; align-items: center; gap: 14px; }
    .pms-logo {
      background: #FF312E;
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      padding: 6px 10px;
      border-radius: 6px;
      letter-spacing: .05em;
    }
    .pms-title { font-size: 15px; font-weight: 700; color: #FFFFFA; }
    .pms-sub   { font-size: 11px; color: #515052; }
    .topbar-right { display: flex; align-items: center; gap: 20px; }
    .topbar-right a {
      font-size: 12px; color: #515052; text-decoration: none; transition: color .15s;
    }
    .topbar-right a:hover { color: #56CBF9; }
    .topbar-right a.active { color: #56CBF9; font-weight: 600; }
    .leader-badge {
      display: flex; align-items: center; gap: 8px;
      background: rgba(86,203,249,.08);
      border: 1px solid rgba(86,203,249,.2);
      border-radius: 20px;
      padding: 4px 12px 4px 8px;
    }
    .leader-dot {
      width: 6px; height: 6px; border-radius: 50%; background: #56CBF9;
    }
    .leader-name { font-size: 12px; color: #56CBF9; font-weight: 600; }

    /* ── Body Layout ── */
    .body { display: flex; flex: 1; overflow: hidden; }

    /* ── Sidebar Nav ── */
    .sidenav {
      width: 200px;
      flex-shrink: 0;
      background: #000103;
      border-right: 1px solid rgba(86,203,249,.1);
      padding: 20px 10px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .nav-item {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 12px;
      border-radius: 7px;
      cursor: pointer;
      font-size: 12px; font-weight: 600; color: #515052;
      border: 1px solid transparent;
      transition: all .15s;
      text-decoration: none;
    }
    .nav-item:hover { background: rgba(86,203,249,.06); color: #FFFFFA; }
    .nav-item.active {
      background: rgba(255,49,46,.12);
      border-color: rgba(255,49,46,.3);
      color: #FF729F;
    }
    .nav-icon { font-size: 13px; width: 16px; text-align: center; }

    /* ── Main Content ── */
    .content { flex: 1; background: #1e2035; padding: 28px; overflow-y: auto; }

    .breadcrumb { font-size: 11px; color: #515052; margin-bottom: 16px; }
    .breadcrumb span { color: #56CBF9; }

    .page-title { font-size: 24px; font-weight: 700; color: #FFFFFA; margin-bottom: 20px; }
    .page-title em { font-style: normal; font-size: 13px; color: #56CBF9; font-weight: 600; margin-left: 10px; }

    /* ── Analytics Panel ── */
    .analytics {
      display: flex;
      gap: 0;
      background: #252b40;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid rgba(86,203,249,.1);
      min-height: 480px;
    }

    /* Member list */
    .member-list {
      width: 260px;
      flex-shrink: 0;
      background: #000103;
      border-right: 1px solid rgba(86,203,249,.1);
      padding: 20px 14px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .ml-title { font-size: 15px; font-weight: 700; color: #FFFFFA; margin-bottom: 2px; }
    .ml-sub   { font-size: 11px; color: #515052; margin-bottom: 14px; }

    .mrow {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border-radius: 8px; cursor: pointer;
      border: 1px solid transparent; transition: all .15s;
    }
    .mrow:hover { background: rgba(86,203,249,.06); border-color: rgba(86,203,249,.12); }
    .mrow.on   { background: rgba(255,49,46,.1);   border-color: rgba(255,49,46,.35); }

    .av {
      width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; font-weight: 700;
      border: 2px solid rgba(255,255,255,.1);
    }
    .av-d { background: #7a3a00; color: #FFB347; }
    .av-a { background: #0a4a2f; color: #56CBF9; }
    .av-s { background: #1a1060; color: #81F4E1; }
    .av-k { background: #0a4a2f; color: #56CBF9; }

    .minfo { flex: 1; min-width: 0; }
    .mname { font-size: 13px; font-weight: 600; color: #FFFFFA; }
    .mrole { font-size: 11px; color: #515052; margin-top: 1px; }

    .pill {
      font-size: 10px; font-weight: 700; padding: 3px 9px;
      border-radius: 20px; letter-spacing: .04em; flex-shrink: 0;
    }
    .pm { background: #4a1a00; color: #FFB347; border: 1px solid #7a3a00; }
    .pl { background: #003020; color: #56CBF9; border: 1px solid #005040; }
    .arr { font-size: 10px; color: #515052; margin-left: 2px; transition: color .15s; }
    .mrow.on .arr { color: #FF312E; }

    /* Profile panel */
    .profile-panel { flex: 1; padding: 26px 28px; overflow-y: auto; }

    .empty-state {
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      height: 400px; gap: 12px;
      color: #515052; font-size: 13px;
    }
    .empty-state svg { width: 42px; height: 42px; stroke: #515052; fill: none; opacity: .45; }

    .phead {
      display: flex; align-items: center; gap: 18px;
      margin-bottom: 24px; padding-bottom: 20px;
      border-bottom: 1px solid rgba(255,255,255,.06);
    }
    .pav {
      width: 56px; height: 56px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; font-weight: 700;
      border: 2px solid rgba(255,255,255,.12);
    }
    .ptitle { font-size: 20px; font-weight: 700; color: #FFFFFA; margin-bottom: 4px; }
    .pmeta  { font-size: 12px; color: #515052; }

    .kgrid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: 10px; margin-bottom: 24px;
    }
    .kcard {
      background: #000103;
      border: 1px solid rgba(86,203,249,.12);
      border-radius: 10px; padding: 16px 10px; text-align: center;
    }
    .klbl {
      font-size: 10px; color: #515052;
      text-transform: uppercase; letter-spacing: .08em;
      margin-bottom: 10px; font-weight: 600;
    }
    .knum { font-size: 28px; font-weight: 700; line-height: 1; }
    .c-blue   { color: #56CBF9; }
    .c-green  { color: #81F4E1; }
    .c-red    { color: #FF312E; }
    .c-purple { color: #FF729F; }

    .ihead { font-size: 14px; font-weight: 700; color: #FFFFFA; margin-bottom: 12px; }

    .icard { border-radius: 10px; border: 1px solid; padding: 14px 16px; margin-bottom: 10px; }
    .icard.str { background: rgba(129,244,225,.06); border-color: rgba(129,244,225,.2); }
    .icard.imp { background: rgba(255,49,46,.06);   border-color: rgba(255,49,46,.25); }
    .icard.exe { background: rgba(86,203,249,.05);  border-color: rgba(86,203,249,.15); }

    .itop { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; }
    .iicon { width: 15px; height: 15px; flex-shrink: 0; fill: none; stroke-width: 2; }
    .itag  { font-size: 12px; font-weight: 700; }
    .tg { color: #81F4E1; }
    .tw { color: #FF312E; }
    .tb { color: #56CBF9; }
    .ibody { font-size: 12px; color: #8a8d9a; line-height: 1.65; }
  </style>
</head>
<body>

  <!-- Top bar -->
  <div class="topbar">
    <div class="topbar-left">
      <span class="pms-logo">PMS</span>
      <div>
        <div class="pms-title">Project Monitoring System</div>
        <div class="pms-sub">v2.0 — Team Intelligence</div>
      </div>
    </div>
    <div class="topbar-right">
      <div class="leader-badge">
        <div class="leader-dot"></div>
        <span class="leader-name">Jarmil Patel</span>
      </div>
      <a href="#" class="active">Team Analytics</a>
      <a href="#">Update Profile</a>
      <a href="#" style="color:#FF312E">Logout</a>
    </div>
  </div>

  <div class="body">
    <!-- Side nav -->
    <nav class="sidenav">
      <a class="nav-item" href="#"><span class="nav-icon">⊞</span> Dashboard</a>
      <a class="nav-item" href="#"><span class="nav-icon">◫</span> Projects</a>
      <a class="nav-item" href="#"><span class="nav-icon">◈</span> My Team</a>
      <a class="nav-item" href="#"><span class="nav-icon">✓</span> Tasks</a>
      <a class="nav-item active" href="#"><span class="nav-icon">◉</span> Team Analytics</a>
      <a class="nav-item" href="#"><span class="nav-icon">⊙</span> Review Tasks</a>
      <a class="nav-item" href="#"><span class="nav-icon">◷</span> Team Leaves</a>
      <a class="nav-item" href="#"><span class="nav-icon">◎</span> Team Queries</a>
    </nav>

    <!-- Main -->
    <div class="content">
      <div class="breadcrumb">Dashboard &rsaquo; <span>Team_Analytics</span></div>
      <div class="page-title">Team Intelligence Analytics <em>Performance Deep-Dive Engine</em></div>

      <div class="analytics">
        <!-- Member list -->
        <div class="member-list">
          <div class="ml-title">Team Members</div>
          <div class="ml-sub">Click a member to view profile</div>

          <div class="mrow" id="r-dev" onclick="pick('dev')">
            <div class="av av-d">D</div>
            <div class="minfo"><div class="mname">Dev Patel</div><div class="mrole">Team Member · IT</div></div>
            <span class="pill pm">M</span><span class="arr">▶</span>
          </div>
          <div class="mrow" id="r-ayush" onclick="pick('ayush')">
            <div class="av av-a">A</div>
            <div class="minfo"><div class="mname">Ayush Patel</div><div class="mrole">Team Member · IT</div></div>
            <span class="pill pl">L</span><span class="arr">▶</span>
          </div>
          <div class="mrow" id="r-sharavan" onclick="pick('sharavan')">
            <div class="av av-s">S</div>
            <div class="minfo"><div class="mname">Sharavan Panchal</div><div class="mrole">Team Member · IT</div></div>
            <span class="pill pl">L</span><span class="arr">▶</span>
          </div>
          <div class="mrow" id="r-krishn" onclick="pick('krishn')">
            <div class="av av-k">K</div>
            <div class="minfo"><div class="mname">Krishn Shukala</div><div class="mrole">Team Member · QA</div></div>
            <span class="pill pl">L</span><span class="arr">▶</span>
          </div>
        </div>

        <!-- Profile panel -->
        <div class="profile-panel">
          <div id="emp" class="empty-state">
            <svg viewBox="0 0 24 24" stroke-width="1.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
            </svg>
            <span>Select a team member to view their profile</span>
          </div>

          <div id="pane" style="display:none">
            <div class="phead">
              <div class="pav" id="pav"></div>
              <div>
                <div class="ptitle" id="pname"></div>
                <div class="pmeta" id="pmeta"></div>
              </div>
            </div>

            <div class="kgrid">
              <div class="kcard"><div class="klbl">Score</div><div class="knum c-blue"   id="ks"></div></div>
              <div class="kcard"><div class="klbl">Completed</div><div class="knum c-green" id="kc"></div></div>
              <div class="kcard"><div class="klbl">Delayed</div><div class="knum c-red"   id="kd"></div></div>
              <div class="kcard"><div class="klbl">Avg Time</div><div class="knum c-purple" id="kt"></div></div>
            </div>

            <div class="ihead">Autogenerated Insights</div>

            <div class="icard str">
              <div class="itop">
                <svg class="iicon" viewBox="0 0 24 24" stroke="#81F4E1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="itag tg">Key Strengths</span>
              </div>
              <div class="ibody" id="istr"></div>
            </div>

            <div class="icard imp">
              <div class="itop">
                <svg class="iicon" viewBox="0 0 24 24" stroke="#FF312E">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
                </svg>
                <span class="itag tw">Areas for Improvement</span>
              </div>
              <div class="ibody" id="iimp"></div>
            </div>

            <div class="icard exe">
              <div class="itop">
                <svg class="iicon" viewBox="0 0 24 24" stroke="#56CBF9">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z"/>
                </svg>
                <span class="itag tb">Executive Summary</span>
              </div>
              <div class="ibody" id="isum"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const M = {
      dev: {
        n:'Dev Patel', i:'D', c:'av-d', r:'Team Member · IT', e:'Jarmil Patel',
        s:'33%', co:'1', d:'1', t:'7.0d',
        str:'Showing consistent presence and engagement with assigned task modules.',
        imp:'Requires closer supervision on deadline management and task prioritization.',
        sum:'Dev Patel shows a medium risk profile. Burnout/Load: Balanced. Has 0 pending and 1 task(s) in progress.'
      },
      ayush: {
        n:'Ayush Patel', i:'A', c:'av-a', r:'Team Member · IT', e:'Jarmil Patel',
        s:'0%', co:'0', d:'0', t:'—',
        str:'Task awareness with 1 item currently in progress.',
        imp:'Begin completing assigned tasks and log hours consistently.',
        sum:'Ayush Patel is at an early stage with 0 completions. Burnout/Load: Balanced. 1 pending task needs attention.'
      },
      sharavan: {
        n:'Sharavan Panchal', i:'S', c:'av-s', r:'Team Member · IT', e:'Jarmil Patel',
        s:'75%', co:'3', d:'0', t:'5.2d',
        str:'Strong completion rate with zero delayed tasks — reliable delivery.',
        imp:'Maintain momentum and take on higher complexity tasks next cycle.',
        sum:'Sharavan Panchal shows a low risk profile. Burnout/Load: Balanced. No overdue items — on track.'
      },
      krishn: {
        n:'Krishn Shukala', i:'K', c:'av-k', r:'Team Member · QA', e:'Jarmil Patel',
        s:'60%', co:'2', d:'1', t:'6.1d',
        str:'Solid QA coverage with good testing throughput across modules.',
        imp:'Reduce delay rate by improving task hand-off with the dev team.',
        sum:'Krishn Shukala shows a low-medium risk profile. Burnout/Load: Balanced. 1 delayed item requires follow-up.'
      }
    };

    let cur = null;

    function pick(id) {
      if (cur) document.getElementById('r-' + cur).classList.remove('on');
      if (cur === id) {
        cur = null;
        document.getElementById('emp').style.display = '';
        document.getElementById('pane').style.display = 'none';
        return;
      }
      cur = id;
      document.getElementById('r-' + id).classList.add('on');
      const m = M[id];
      const av = document.getElementById('pav');
      av.className = 'pav av ' + m.c;
      av.textContent = m.i;
      document.getElementById('pname').textContent = 'Performance Profile: ' + m.n;
      document.getElementById('pmeta').textContent = m.r + ' | Evaluated by: ' + m.e;
      document.getElementById('ks').textContent = m.s;
      document.getElementById('kc').textContent = m.co;
      document.getElementById('kd').textContent = m.d;
      document.getElementById('kt').textContent = m.t;
      document.getElementById('istr').textContent = m.str;
      document.getElementById('iimp').textContent = m.imp;
      document.getElementById('isum').textContent = m.sum;
      document.getElementById('emp').style.display = 'none';
      document.getElementById('pane').style.display = 'block';
    }
  </script>
</body>
</html>
